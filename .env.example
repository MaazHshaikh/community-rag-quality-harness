# Providers: "ollama" (real models) or "stub" (deterministic, no network; for tests).
# LLM_PROVIDER can also be "anthropic" (Claude): layer .env.claude over this file.
EMBED_PROVIDER=ollama
LLM_PROVIDER=ollama

# Ollama settings (only read when a provider is "ollama")
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=300

# Anthropic API key, only read when LLM_PROVIDER is "anthropic". Never commit a real key.
ANTHROPIC_API_KEY=

# Bearer token required by /search and /ask. Use a long random value.
API_TOKEN=change-me
