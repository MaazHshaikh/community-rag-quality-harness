# Layered over .env to answer with Claude instead of llama3.2:3b: npm run dev:claude, npm run eval:all:claude
# Embeddings stay on Ollama (nomic-embed-text), so retrieval is unchanged. Same output limit as
# .env. Temperature can't match: claude-haiku-5-5 rejects the parameter ("temperature is
# deprecated for this model"), so no temperature is sent and /meta reports it as null.
# Needs ANTHROPIC_API_KEY in .env (never in this file: it's committed).
LLM_PROVIDER=anthropic
CHAT_MODEL=claude-haiku-5-5
LLM_TEMPERATURE=model-default
